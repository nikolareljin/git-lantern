#!/usr/bin/env bash
# SCRIPT: install
# DESCRIPTION: Wrapper that delegates to scripts/install.sh.
# USAGE: ./install [--dev] [--prefix PATH] [--bin-link PATH] [--dry-run]
# PARAMETERS: Optional flags: --dev, --prefix, --bin-link, --dry-run.
# EXAMPLE: ./install --dry-run
set -euo pipefail
"$(dirname "$0")/scripts/install.sh" "$@"
