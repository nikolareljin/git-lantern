#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# git exports these to hooks; left set, the tests' own git calls act on this
# repository instead of their temp directories (tests/conftest.py clears them too).
# shellcheck disable=SC2046  # one variable name per word
unset $(git rev-parse --local-env-vars 2>/dev/null || true) \
  GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY

if [[ "${SKIP_LANTERN_PRECOMMIT:-}" == "1" ]]; then
  echo "Skipping git-lantern pre-commit checks (SKIP_LANTERN_PRECOMMIT=1)."
  exit 0
fi

if [[ "${LANTERN_PRECOMMIT_FAST:-}" == "1" ]]; then
  bash "$ROOT_DIR/scripts/lint.sh"
  exit 0
fi

bash "$ROOT_DIR/scripts/local_ci.sh"
